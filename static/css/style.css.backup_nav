* {
    box-sizing: border-box;
    margin: 0;
    padding: 0;
}


body {
    font-family: Arial, sans-serif;

    background: #f5f8f6;

    color: #172033;
}


/* NAVBAR */

/* =========================
   WASTECARE PROFESSIONAL NAVBAR
   ========================= */

.navbar {
    min-height: 68px;
    padding: 8px 4%;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 18px;

    background: rgba(255, 255, 255, 0.97);
    border-bottom: 1px solid #e8eee9;
    box-shadow: 0 4px 18px rgba(0, 0, 0, 0.07);

    position: sticky;
    top: 0;
    z-index: 1000;
}


/* BRAND */

.navbar .logo {
    display: flex;
    align-items: center;
    gap: 7px;

    color: #16834a;
    font-size: 20px;
    font-weight: 800;
    letter-spacing: -0.3px;

    white-space: nowrap;
}


/* NAVIGATION CONTAINER */

.navbar nav {
    display: flex;
    align-items: center;
    gap: 5px;

    padding: 5px;

    background: #f5f9f6;
    border: 1px solid #e3ebe5;
    border-radius: 15px;
}


/* NAVIGATION BUTTONS */

.navbar nav a {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 5px;

    padding: 9px 11px;

    color: #344054;
    text-decoration: none;

    font-size: 13px;
    font-weight: 650;

    border-radius: 10px;

    white-space: nowrap;

    transition:
        background 0.2s ease,
        color 0.2s ease,
        transform 0.2s ease,
        box-shadow 0.2s ease;
}


/* HOVER */

.navbar nav a:hover {
    background: white;
    color: #16834a;

    box-shadow: 0 3px 10px rgba(0, 0, 0, 0.08);

    transform: translateY(-1px);
}


/* CLICK */

.navbar nav a:active {
    transform: scale(0.96);
}


/* LOGOUT */

.navbar nav a[href="/logout"] {
    color: #b42318;
}

.navbar nav a[href="/logout"]:hover {
    color: #b42318;
    background: #fff5f4;
}


/* LOGIN */

.navbar nav a[href="/login"] {
    color: #16834a;
}


/* =========================
   MOBILE NAVBAR
   ========================= */

@media (max-width: 700px) {

    .navbar {
        padding: 8px 10px;
        gap: 8px;

        overflow-x: auto;
        justify-content: flex-start;

        scrollbar-width: none;
    }

    .navbar::-webkit-scrollbar {
        display: none;
    }


    .navbar .logo {
        font-size: 16px;
        flex-shrink: 0;
    }


    .navbar nav {
        flex-shrink: 0;

        gap: 3px;
        padding: 4px;

        border-radius: 13px;
    }


    .navbar nav a {
        padding: 8px 9px;

        font-size: 11.5px;

        border-radius: 9px;
    }
}

/* HERO */

.hero {
    min-height: 520px;

    padding: 70px 7%;

    display: flex;

    align-items: center;

    justify-content: space-between;

    gap: 40px;

    background:
        linear-gradient(
            135deg,
            #e8f8ef,
            #f7fcf9
        );
}


.hero-content {
    max-width: 650px;
}


.tagline {
    color: #16834a;

    font-weight: bold;

    margin-bottom: 15px;
}


.hero h1 {
    font-size: 52px;

    line-height: 1.1;

    margin-bottom: 20px;
}


.description {
    font-size: 18px;

    line-height: 1.7;

    color: #667085;

    margin-bottom: 30px;
}


.hero-buttons {
    display: flex;

    gap: 15px;
}


.primary-btn,
.secondary-btn {
    display: inline-block;

    padding: 13px 22px;

    border-radius: 9px;

    text-decoration: none;

    font-weight: bold;
}


.primary-btn {
    background: #16834a;

    color: white;
}


.secondary-btn {
    background: white;

    color: #16834a;

    border: 1px solid #16834a;
}


.hero-icon {
    width: 250px;

    height: 250px;

    display: flex;

    align-items: center;

    justify-content: center;

    font-size: 130px;

    background: white;

    border-radius: 50%;

    box-shadow:
        0 15px 40px
        rgba(0, 0, 0, 0.08);
}


/* FEATURES */

.features {
    padding: 60px 7%;

    display: grid;

    grid-template-columns:
        repeat(4, 1fr);

    gap: 20px;
}


.feature-card {
    background: white;

    padding: 30px;

    border-radius: 15px;

    text-align: center;

    box-shadow:
        0 5px 20px
        rgba(0, 0, 0, 0.05);
}


.feature-icon {
    font-size: 42px;

    margin-bottom: 15px;
}


.feature-card h2 {
    margin-bottom: 10px;
}


.feature-card p {
    color: #718096;

    line-height: 1.6;
}


/* FOOTER */

footer {
    padding: 25px;

    text-align: center;

    background: #172033;

    color: white;
}


/* MOBILE */

@media (max-width: 900px) {

    .hero {
        flex-direction: column;

        text-align: center;
    }

    .hero-buttons {
        justify-content: center;
    }

    .features {
        grid-template-columns:
            repeat(2, 1fr);
    }

}


@media (max-width: 600px) {

    .navbar {
        padding: 0 20px;
    }

    .navbar nav {
        gap: 10px;
    }

    .navbar nav a {
        font-size: 13px;
    }

    .hero {
        padding: 50px 20px;
    }

    .hero h1 {
        font-size: 38px;
    }

    .hero-icon {
        width: 180px;
        height: 180px;

        font-size: 90px;
    }

    .features {
        grid-template-columns: 1fr;

        padding: 40px 20px;
    }

}

/* =========================
   WASTE REPORT PAGE
   ========================= */

.report-section {
    padding: 60px 20px;
    background: #f5f7f5;
    min-height: 80vh;
}

.report-container {
    max-width: 800px;
    margin: auto;
}

.report-header {
    text-align: center;
    margin-bottom: 35px;
}

.report-header h1 {
    font-size: 42px;
    margin: 10px 0;
}

.report-header p {
    color: #666;
    line-height: 1.6;
}

.report-form {
    background: white;
    padding: 35px;
    border-radius: 15px;
    box-shadow: 0 5px 20px rgba(0, 0, 0, 0.08);
}

.form-group {
    margin-bottom: 22px;
}

.form-group label {
    display: block;
    font-weight: bold;
    margin-bottom: 8px;
}

.form-group input,
.form-group select,
.form-group textarea {
    width: 100%;
    padding: 13px;
    border: 1px solid #ccc;
    border-radius: 8px;
    font-size: 16px;
    box-sizing: border-box;
}

.form-group textarea {
    resize: vertical;
}

.form-group input:focus,
.form-group select:focus,
.form-group textarea:focus {
    outline: none;
    border-color: #2e7d32;
}

.form-group small {
    display: block;
    margin-top: 6px;
    color: #777;
}

.submit-btn {
    width: 100%;
    padding: 14px;
    border: none;
    border-radius: 8px;
    background: #2e7d32;
    color: white;
    font-size: 17px;
    font-weight: bold;
    cursor: pointer;
}

.submit-btn:hover {
    background: #1b5e20;
}


@media (max-width: 600px) {

    .report-section {
        padding: 35px 15px;
    }

    .report-header h1 {
        font-size: 32px;
    }

    .report-form {
        padding: 22px;
    }

}

/* =========================
   WASTE REPORTS DASHBOARD
   ========================= */

.reports-section {
    padding: 60px 20px;
    background: #f5f7f5;
    min-height: 80vh;
}

.reports-container {
    max-width: 1100px;
    margin: auto;
}

.reports-header {
    text-align: center;
    margin-bottom: 40px;
}

.reports-header h1 {
    font-size: 42px;
    margin: 10px 0;
}

.reports-header p {
    color: #666;
}

.reports-grid {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 25px;
}

.report-card {
    background: white;
    border-radius: 15px;
    overflow: hidden;
    box-shadow: 0 5px 20px rgba(0, 0, 0, 0.08);
}

.report-image {
    width: 100%;
    height: 220px;
    object-fit: cover;
}

.no-image {
    height: 220px;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    background: #eee;
    font-size: 40px;
}

.no-image p {
    font-size: 15px;
    color: #777;
}

.report-content {
    padding: 22px;
}

.report-content h2 {
    margin: 12px 0;
}

.report-content p {
    line-height: 1.6;
    color: #555;
}

.status {
    display: inline-block;
    padding: 6px 12px;
    border-radius: 20px;
    background: #fff3cd;
    color: #856404;
    font-size: 13px;
    font-weight: bold;
}

.report-date {
    font-size: 13px;
    color: #888 !important;
}

.no-reports {
    text-align: center;
    background: white;
    padding: 50px;
    border-radius: 15px;
}


/* Mobile */

@media (max-width: 700px) {

    .reports-section {
        padding: 35px 15px;
    }

    .reports-header h1 {
        font-size: 32px;
    }

    .reports-grid {
        grid-template-columns: 1fr;
    }

}

/* =========================
   STATUS UPDATE
   ========================= */

.status-form {
    margin-top: 20px;
    padding-top: 18px;
    border-top: 1px solid #eee;
}

.status-form label {
    display: block;
    font-weight: bold;
    margin-bottom: 8px;
}

.status-form select {
    width: 100%;
    padding: 10px;
    border: 1px solid #ccc;
    border-radius: 7px;
    margin-bottom: 10px;
    font-size: 15px;
}

.status-form button {
    width: 100%;
    padding: 10px;
    border: none;
    border-radius: 7px;
    background: #2e7d32;
    color: white;
    font-weight: bold;
    cursor: pointer;
}

.status-form button:hover {
    background: #1b5e20;
}

/* =========================
   ADMIN DASHBOARD
   ========================= */

.dashboard-section {
    padding: 60px 20px;
    background: #f5f7f5;
    min-height: 80vh;
}

.dashboard-container {
    max-width: 1100px;
    margin: auto;
}

.dashboard-header {
    text-align: center;
    margin-bottom: 40px;
}

.dashboard-header h1 {
    font-size: 42px;
    margin: 10px 0;
}

.dashboard-header p {
    color: #666;
}


/* Statistics */

.stats-grid {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 20px;
}

.stat-card {
    background: white;
    padding: 25px;
    text-align: center;
    border-radius: 15px;
    box-shadow: 0 5px 20px rgba(0, 0, 0, 0.08);
}

.stat-icon {
    font-size: 35px;
}

.stat-card h2 {
    font-size: 35px;
    margin: 10px 0 5px;
}

.stat-card p {
    color: #666;
    margin: 0;
}


/* Category */

.category-section {
    background: white;
    margin-top: 30px;
    padding: 25px;
    border-radius: 15px;
    box-shadow: 0 5px 20px rgba(0, 0, 0, 0.08);
}

.category-section h2 {
    margin-top: 0;
}

.category-row {
    display: flex;
    justify-content: space-between;
    padding: 15px 5px;
    border-bottom: 1px solid #eee;
}

.category-row:last-child {
    border-bottom: none;
}


/* Buttons */

.dashboard-actions {
    display: flex;
    justify-content: center;
    gap: 15px;
    margin-top: 30px;
}


/* Mobile */

@media (max-width: 800px) {

    .stats-grid {
        grid-template-columns: repeat(2, 1fr);
    }

}


@media (max-width: 500px) {

    .dashboard-section {
        padding: 35px 15px;
    }

    .dashboard-header h1 {
        font-size: 32px;
    }

    .stats-grid {
        grid-template-columns: 1fr;
    }

    .dashboard-actions {
        flex-direction: column;
    }

}


.location-btn {
    margin-top: 10px;
    padding: 10px 15px;
    border: none;
    border-radius: 7px;
    background: #e8f5e9;
    color: #2e7d32;
    font-weight: bold;
    cursor: pointer;
}

.location-btn:hover {
    background: #c8e6c9;
}

.location-status {
    margin-top: 8px;
    font-size: 14px;
}

.map-btn {
    display: inline-block;
    margin-top: 10px;
    padding: 10px 15px;
    background: #e8f5e9;
    color: #2e7d32;
    text-decoration: none;
    border-radius: 7px;
    font-weight: bold;
}

.map-btn:hover {
    background: #c8e6c9;
}

/* =========================
   WASTE MAP
   ========================= */

.map-section {
    padding: 50px 20px;
    background: #f5f7f5;
    min-height: 80vh;
}

.map-container {
    max-width: 1100px;
    margin: auto;
}

.map-header {
    text-align: center;
    margin-bottom: 30px;
}

.map-header h1 {
    font-size: 42px;
    margin: 10px 0;
}

.map-header p {
    color: #666;
}

#waste-map {
    width: 100%;
    height: 550px;
    border-radius: 15px;
    overflow: hidden;
    box-shadow: 0 5px 20px rgba(0, 0, 0, 0.12);
}

@media (max-width: 600px) {

    .map-section {
        padding: 30px 15px;
    }

    .map-header h1 {
        font-size: 32px;
    }

    #waste-map {
        height: 450px;
    }

}


/* =========================
   COLLECTION MANAGEMENT
   ========================= */

.collection-box {
    margin-top: 20px;
    padding: 20px;
    background: #f8faf8;
    border-radius: 10px;
}

.collection-box h3,
.collection-details h3 {
    margin-top: 0;
}

.collection-form label {
    display: block;
    margin-top: 12px;
    margin-bottom: 6px;
    font-weight: bold;
}

.collection-form input,
.collection-form textarea {
    width: 100%;
    box-sizing: border-box;
    padding: 10px;
    border: 1px solid #ccc;
    border-radius: 7px;
    font-size: 15px;
}

.collection-form button {
    width: 100%;
    margin-top: 18px;
    padding: 11px;
    border: none;
    border-radius: 7px;
    background: #2e7d32;
    color: white;
    font-weight: bold;
    cursor: pointer;
}

.collection-details {
    margin-top: 20px;
    padding: 20px;
    background: #e8f5e9;
    border-radius: 10px;
}

.collection-details p {
    margin: 8px 0;
}


/* ============================= */
/* AUTHENTICATION PAGES */
/* ============================= */

.auth-container {
    min-height: 75vh;
    display: flex;
    justify-content: center;
    align-items: center;
    padding: 30px 15px;
}

.auth-box {
    width: 100%;
    max-width: 420px;
    padding: 35px;
    background: white;
    border-radius: 18px;
    box-shadow: 0 12px 35px rgba(0, 0, 0, 0.12);
    text-align: center;
}

.auth-box h1 {
    margin-bottom: 8px;
    font-size: 30px;
    color: #1b5e20;
}

.auth-box > p {
    color: #666;
    margin-bottom: 28px;
}

.auth-box form {
    text-align: left;
}

.auth-box label {
    display: block;
    margin-top: 15px;
    margin-bottom: 7px;
    font-weight: 600;
    color: #333;
}

.auth-box input {
    width: 100%;
    box-sizing: border-box;
    padding: 13px 14px;
    border: 1px solid #d5d5d5;
    border-radius: 9px;
    font-size: 15px;
    outline: none;
    transition: 0.2s;
}

.auth-box input:focus {
    border-color: #2e7d32;
    box-shadow: 0 0 0 3px rgba(46, 125, 50, 0.12);
}

.auth-box button {
    width: 100%;
    margin-top: 25px;
    padding: 13px;
    border: none;
    border-radius: 9px;
    background: #2e7d32;
    color: white;
    font-size: 16px;
    font-weight: bold;
    cursor: pointer;
    transition: 0.2s;
}

.auth-box button:hover {
    background: #1b5e20;
    transform: translateY(-1px);
}

.auth-link {
    margin-top: 22px !important;
    margin-bottom: 0 !important;
    font-size: 14px;
}

.auth-link a {
    color: #2e7d32;
    font-weight: bold;
    text-decoration: none;
}

.auth-link a:hover {
    text-decoration: underline;
}


/* Mobile */
@media (max-width: 500px) {

    .auth-container {
        padding: 20px 12px;
    }

    .auth-box {
        padding: 25px 20px;
    }

    .auth-box h1 {
        font-size: 26px;
    }

    .auth-icon {
    width: 65px;
    height: 65px;
    margin: 0 auto 15px;
    display: flex;
    justify-content: center;
    align-items: center;
    background: #e8f5e9;
    border-radius: 50%;
    font-size: 30px;
  }
}
/* ============================= */
/* ACCESS DENIED PAGE */
/* ============================= */

.access-container {
    min-height: 75vh;
    display: flex;
    justify-content: center;
    align-items: center;
    padding: 30px 15px;
}

.access-card {
    width: 100%;
    max-width: 500px;
    padding: 40px 30px;
    text-align: center;
    background: white;
    border-radius: 20px;
    box-shadow: 0 12px 35px rgba(0, 0, 0, 0.12);
}

.access-icon {
    width: 80px;
    height: 80px;
    margin: 0 auto 20px;
    display: flex;
    justify-content: center;
    align-items: center;
    background: #fff3e0;
    border-radius: 50%;
    font-size: 38px;
}

.access-card h1 {
    margin: 0 0 10px;
    color: #333;
    font-size: 28px;
}

.access-card > p {
    color: #666;
    line-height: 1.6;
    margin-bottom: 25px;
}

.access-info {
    display: flex;
    align-items: center;
    gap: 15px;
    text-align: left;
    padding: 16px;
    margin-bottom: 25px;
    background: #f8f9f8;
    border-radius: 12px;
}

.access-info span {
    font-size: 25px;
}

.access-info strong {
    display: block;
    margin-bottom: 5px;
}

.access-info small {
    color: #777;
}

.access-buttons {
    display: flex;
    gap: 12px;
    justify-content: center;
}

.access-buttons a {
    padding: 11px 18px;
    border-radius: 8px;
    text-decoration: none;
    font-weight: 600;
}

.home-btn {
    background: #2e7d32;
    color: white;
}

.logout-btn {
    background: #eeeeee;
    color: #333;
}

.home-btn:hover {
    background: #1b5e20;
}

.logout-btn:hover {
    background: #dddddd;
}


/* Mobile */

@media (max-width: 500px) {

    .access-card {
        padding: 30px 20px;
    }

    .access-buttons {
        flex-direction: column;
    }

    .access-buttons a {
        width: 100%;
        box-sizing: border-box;
    }
}
/* ============================= */
/* MY REPORTS PAGE */
/* ============================= */

.page-container {
    max-width: 1100px;
    margin: 0 auto;
    padding: 35px 20px;
}

.page-header {
    text-align: center;
    margin-bottom: 30px;
}

.page-header h1 {
    color: #1b5e20;
    margin-bottom: 8px;
    font-size: 32px;
}

.page-header p {
    color: #666;
    font-size: 16px;
}


/* Reports Grid */

.reports-grid {
    display: grid;
    grid-template-columns: repeat(
        auto-fit,
        minmax(300px, 1fr)
    );
    gap: 25px;
}


/* Report Card */

.report-card {
    background: white;
    border-radius: 16px;
    overflow: hidden;
    box-shadow: 0 8px 25px rgba(0, 0, 0, 0.10);
    transition: 0.25s;
}

.report-card:hover {
    transform: translateY(-5px);
    box-shadow: 0 14px 30px rgba(0, 0, 0, 0.15);
}


/* Image */

.report-image {
    width: 100%;
    height: 210px;
    object-fit: cover;
    display: block;
}


/* Content */

.report-content {
    padding: 20px;
}

.report-top {
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: 10px;
}

.report-top h2 {
    margin: 0;
    color: #333;
    font-size: 21px;
}


/* Status */

.status {
    padding: 6px 11px;
    border-radius: 20px;
    font-size: 12px;
    font-weight: bold;
    white-space: nowrap;
}

.status-pending {
    background: #fff3cd;
    color: #856404;
}

.status-progress {
    background: #cfe2ff;
    color: #084298;
}

.status-collected {
    background: #d1e7dd;
    color: #0f5132;
}


/* Description */

.report-description {
    margin: 15px 0;
    color: #555;
    line-height: 1.6;
}


/* Information */

.report-info {
    background: #f7f9f7;
    padding: 12px;
    border-radius: 10px;
    margin-bottom: 15px;
}

.report-info p {
    margin: 7px 0;
    color: #555;
    font-size: 14px;
}


/* Map Button */

.map-button {
    display: inline-block;
    padding: 9px 14px;
    background: #2e7d32;
    color: white;
    border-radius: 8px;
    text-decoration: none;
    font-size: 14px;
    font-weight: 600;
    transition: 0.2s;
}

.map-button:hover {
    background: #1b5e20;
}


/* Collection Details */

.collection-info {
    margin-top: 18px;
    padding: 15px;
    background: #e8f5e9;
    border-left: 4px solid #2e7d32;
    border-radius: 8px;
}

.collection-info h3 {
    margin-top: 0;
    margin-bottom: 10px;
    color: #1b5e20;
    font-size: 17px;
}

.collection-info p {
    margin: 7px 0;
    font-size: 14px;
    color: #444;
}


/* No Reports */

.no-reports {
    max-width: 500px;
    margin: 50px auto;
    padding: 45px 25px;
    text-align: center;
    background: white;
    border-radius: 18px;
    box-shadow: 0 8px 25px rgba(0, 0, 0, 0.10);
}

.no-reports-icon {
    font-size: 55px;
    margin-bottom: 15px;
}

.no-reports h2 {
    color: #333;
    margin-bottom: 8px;
}

.no-reports p {
    color: #666;
    margin-bottom: 25px;
}


/* Report Button */

.report-button {
    display: inline-block;
    padding: 12px 20px;
    background: #2e7d32;
    color: white;
    text-decoration: none;
    border-radius: 9px;
    font-weight: bold;
}

.report-button:hover {
    background: #1b5e20;
}


/* Mobile */

@media (max-width: 600px) {

    .page-container {
        padding: 25px 12px;
    }

    .page-header h1 {
        font-size: 27px;
    }

    .report-top {
        align-items: flex-start;
    }

    .report-top h2 {
        font-size: 18px;
    }

}
/* ============================= */
/* NOTIFICATIONS */
/* ============================= */

.notifications-list {
    max-width: 850px;
    margin: 0 auto;
    display: flex;
    flex-direction: column;
    gap: 15px;
}

.notification-card {
    display: flex;
    align-items: center;
    gap: 15px;
    padding: 18px 20px;
    background: white;
    border-radius: 14px;
    box-shadow: 0 6px 20px rgba(0, 0, 0, 0.08);
    border-left: 4px solid transparent;
    position: relative;
}

.notification-card.unread {
    border-left-color: #2e7d32;
    background: #f1f8f2;
}

.notification-icon {
    width: 48px;
    height: 48px;
    min-width: 48px;
    display: flex;
    justify-content: center;
    align-items: center;
    background: #e8f5e9;
    border-radius: 50%;
    font-size: 23px;
}

.notification-content {
    flex: 1;
}

.notification-content p {
    margin: 0 0 7px;
    color: #333;
    line-height: 1.5;
}

.notification-content small {
    color: #777;
}

.new-badge {
    background: #2e7d32;
    color: white;
    padding: 5px 9px;
    border-radius: 12px;
    font-size: 10px;
    font-weight: bold;
}

@media (max-width: 600px) {

    .notification-card {
        padding: 15px;
    }

    .notification-icon {
        width: 40px;
        height: 40px;
        min-width: 40px;
        font-size: 19px;
    }

    .notification-content p {
        font-size: 14px;
    }

    .new-badge {
        position: absolute;
        top: 10px;
        right: 10px;
    }
}

/* =========================
   ABOUT / LEARN MORE PAGE
   ========================= */

.about-page {
    background: #f4f8f5;
    min-height: 100vh;
    padding-bottom: 60px;
}

.about-hero {
    text-align: center;
    padding: 55px 20px 45px;
    background: linear-gradient(
        135deg,
        #eaf8ef,
        #f8fcf9
    );
}

.about-icon {
    font-size: 48px;
    margin-bottom: 10px;
}

.about-hero h1 {
    margin: 5px 0 12px;
    color: #172033;
    font-size: 42px;
}

.about-hero p {
    max-width: 700px;
    margin: auto;
    color: #667085;
    line-height: 1.7;
}

.about-container {
    width: 90%;
    max-width: 1050px;
    margin: 35px auto;
}

.about-card {
    background: white;
    border-radius: 18px;
    padding: 28px;
    margin-bottom: 22px;
    box-shadow: 0 5px 18px rgba(0, 0, 0, 0.06);
    border: 1px solid #e7eee9;
}

.about-card h2 {
    color: #16834a;
    margin-top: 0;
    margin-bottom: 15px;
}

.about-card p {
    color: #5f6b66;
    line-height: 1.7;
}

.objective-list {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 12px;
    margin-top: 20px;
}

.objective-list div {
    padding: 14px;
    background: #f3f8f4;
    border-radius: 12px;
    color: #344054;
    font-weight: 600;
}

.steps {
    display: grid;
    gap: 15px;
}

.step {
    display: flex;
    align-items: flex-start;
    gap: 15px;
    padding: 15px;
    background: #f7faf8;
    border-radius: 13px;
}

.step > span {
    min-width: 35px;
    height: 35px;
    display: flex;
    align-items: center;
    justify-content: center;
    background: #16834a;
    color: white;
    border-radius: 50%;
    font-weight: 700;
}

.step h3 {
    margin: 3px 0 5px;
    color: #172033;
}

.step p {
    margin: 0;
}

.waste-grid {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 15px;
}

.waste-item {
    padding: 20px 15px;
    text-align: center;
    background: #f7faf8;
    border-radius: 14px;
}

.waste-item span {
    font-size: 35px;
}

.waste-item h3 {
    color: #172033;
}

.waste-item p {
    font-size: 14px;
}

.segregation-box {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 15px;
    margin-top: 20px;
}

.segregation-box div {
    padding: 18px;
    background: #f2f8f4;
    border-radius: 13px;
}

.segregation-box strong,
.segregation-box span {
    display: block;
}

.segregation-box strong {
    color: #16834a;
    margin-bottom: 8px;
}

.segregation-box span {
    color: #667085;
    font-size: 14px;
    line-height: 1.5;
}

.fact-box {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 15px;
    margin-top: 20px;
}

.fact {
    text-align: center;
    padding: 22px;
    background: #f3f8f4;
    border-radius: 15px;
}

.fact strong {
    display: block;
    font-size: 28px;
    color: #16834a;
    margin-bottom: 10px;
}

.fact span {
    color: #667085;
    font-size: 14px;
    line-height: 1.5;
}

.source-note {
    font-size: 13px;
    margin-top: 18px;
}

.citizen-list {
    padding-left: 20px;
}

.citizen-list li {
    margin: 12px 0;
    color: #475467;
}

.project-highlight {
    text-align: center;
}

.highlight-buttons {
    display: flex;
    justify-content: center;
    gap: 12px;
    margin-top: 25px;
}


/* MOBILE */

@media (max-width: 700px) {

    .about-hero {
        padding: 40px 18px;
    }

    .about-hero h1 {
        font-size: 32px;
    }

    .about-container {
        width: 92%;
    }

    .about-card {
        padding: 20px;
        border-radius: 15px;
    }

    .objective-list {
        grid-template-columns: 1fr;
    }

    .waste-grid {
        grid-template-columns: 1fr 1fr;
    }

    .segregation-box {
        grid-template-columns: 1fr;
    }

    .fact-box {
        grid-template-columns: 1fr;
    }

    .highlight-buttons {
        flex-direction: column;
    }

    .highlight-buttons a {
        width: auto;
    }
}

/* =================================
   WASTECARE MOBILE MENU
   ================================= */

.mobile-report-btn {
    display: none;
}

.menu-toggle {
    display: none;
}


/* =================================
   MOBILE NAVIGATION
   ================================= */

@media (max-width: 700px) {

    .navbar {
        position: sticky;
        top: 0;

        min-height: 62px;

        padding: 8px 12px;

        display: flex;
        align-items: center;

        gap: 8px;

        background: rgba(255, 255, 255, 0.98);

        box-shadow:
            0 4px 18px rgba(0, 0, 0, 0.08);

        z-index: 2000;
    }


    /* LOGO */

    .navbar .logo {
        font-size: 17px;

        flex-shrink: 0;
    }


    /* REPORT WASTE */

    .mobile-report-btn {

        display: flex;

        align-items: center;
        justify-content: center;

        margin-left: auto;

        padding: 9px 12px;

        border-radius: 11px;

        background: #16834a;

        color: white;

        text-decoration: none;

        font-size: 11px;

        font-weight: 700;

        white-space: nowrap;

        box-shadow:
            0 4px 10px rgba(22, 131, 74, 0.20);

        transition: 0.2s ease;
    }


    .mobile-report-btn:active {
        transform: scale(0.95);
    }


    /* HAMBURGER */

    .menu-toggle {

        display: flex;

        width: 42px;
        height: 42px;

        flex-shrink: 0;

        border: none;

        border-radius: 12px;

        background: #f2f7f3;

        align-items: center;
        justify-content: center;

        flex-direction: column;

        gap: 5px;

        cursor: pointer;

        padding: 0;

        transition: 0.25s ease;
    }


    .menu-toggle span {

        width: 20px;
        height: 2px;

        background: #16834a;

        border-radius: 10px;

        transition: 0.25s ease;
    }


    /* HAMBURGER ANIMATION */

    .menu-toggle.active span:nth-child(1) {
        transform:
            translateY(7px)
            rotate(45deg);
    }

    .menu-toggle.active span:nth-child(2) {
        opacity: 0;
        transform: scaleX(0);
    }

    .menu-toggle.active span:nth-child(3) {
        transform:
            translateY(-7px)
            rotate(-45deg);
    }


    .menu-toggle.active {
        background: #e8f5ed;
    }


    /* MOBILE MENU */

    .navbar nav {

        position: absolute;

        top: calc(100% + 8px);

        left: 10px;
        right: 10px;

        display: flex;

        flex-direction: column;

        align-items: stretch;

        gap: 5px;

        padding: 10px;

        background: rgba(255, 255, 255, 0.99);

        border: 1px solid #e2ebe5;

        border-radius: 16px;

        box-shadow:
            0 12px 30px rgba(0, 0, 0, 0.12);

        opacity: 0;

        visibility: hidden;

        transform:
            translateY(-12px)
            scale(0.98);

        transform-origin: top right;

        transition:
            opacity 0.22s ease,
            transform 0.22s ease,
            visibility 0.22s ease;

        z-index: 3000;
    }


    /* OPEN */

    .navbar nav.mobile-open {

        opacity: 1;

        visibility: visible;

        transform:
            translateY(0)
            scale(1);
    }


    /* MENU ITEMS */

    .navbar nav a {

        width: auto;

        min-height: 42px;

        justify-content: flex-start;

        padding: 10px 13px;

        border-radius: 10px;

        font-size: 13px;

        background: transparent;
    }


    .navbar nav a:hover {

        background: #f0f7f2;

        color: #16834a;

        transform: none;

        box-shadow: none;
    }


    .navbar nav a[href="/logout"]:hover {

        background: #fff5f4;
    }


    /* USER NAME */

    .navbar nav .user-name {

        padding: 10px 13px;

        border-radius: 10px;

        background: #f6f9f7;

        color: #475467;

        font-size: 13px;

        font-weight: 600;
    }


    /* DIVIDER */

    .navbar nav .nav-spacer {

        width: 100%;

        height: 1px;

        margin: 3px 0;

        background: #e5ebe7;
    }

}
/* ==========================================
   MOBILE MENU VISIBILITY FIX
   ========================================== */

@media (max-width: 700px) {

    .navbar {
        position: sticky !important;
        top: 0;
        z-index: 9999 !important;
    }

    .navbar nav {
        position: absolute !important;

        top: calc(100% + 8px) !important;
        left: 10px !important;
        right: 10px !important;

        width: auto !important;

        display: flex !important;
        flex-direction: column !important;

        align-items: stretch !important;

        padding: 10px !important;
        gap: 5px !important;

        background: #ffffff !important;

        border: 1px solid #dfe9e2 !important;
        border-radius: 16px !important;

        box-shadow:
            0 15px 35px rgba(0, 0, 0, 0.16) !important;

        opacity: 0 !important;
        visibility: hidden !important;

        pointer-events: none !important;

        transform: translateY(-15px) scale(0.97) !important;

        transition:
            opacity 0.25s ease,
            transform 0.25s ease,
            visibility 0.25s ease !important;

        z-index: 10000 !important;
    }


    /* OPEN MENU */

    .navbar nav.mobile-open {

        display: flex !important;

        opacity: 1 !important;
        visibility: visible !important;

        pointer-events: auto !important;

        transform: translateY(0) scale(1) !important;
    }


    /* MENU LINKS */

    .navbar nav a {

        display: flex !important;

        align-items: center !important;
        justify-content: flex-start !important;

        width: 100% !important;
        min-height: 44px !important;

        padding: 11px 14px !important;

        box-sizing: border-box !important;

        background: transparent !important;

        color: #172033 !important;

        font-size: 14px !important;
        font-weight: 650 !important;

        border-radius: 10px !important;

        text-decoration: none !important;
    }


    .navbar nav a:hover {
        background: #f0f7f2 !important;
        color: #16834a !important;
    }


    /* USER NAME */

    .navbar nav .user-name {

        display: flex !important;

        align-items: center !important;

        width: 100% !important;

        min-height: 44px !important;

        padding: 11px 14px !important;

        box-sizing: border-box !important;

        background: #f5f8f6 !important;

        border-radius: 10px !important;

        color: #475467 !important;
    }


    /* DIVIDER */

    .navbar nav .nav-spacer {

        display: block !important;

        width: 100% !important;
        height: 1px !important;

        margin: 3px 0 !important;

        background: #e5ebe7 !important;
    }

}

/* FINAL MOBILE MENU FIX */

@media (max-width: 700px) {

    .navbar {
        position: sticky !important;
        top: 0 !important;
        overflow: visible !important;
        z-index: 99999 !important;
    }

    .navbar nav {
        position: absolute !important;

        top: calc(100% + 8px) !important;
        left: 10px !important;
        right: 10px !important;

        width: auto !important;

        display: none !important;

        flex-direction: column !important;
        align-items: stretch !important;

        padding: 10px !important;

        background: white !important;

        border: 1px solid #dfe9e2 !important;
        border-radius: 16px !important;

        box-shadow: 0 15px 35px rgba(0,0,0,0.16) !important;

        z-index: 99999 !important;
    }


    .navbar nav.mobile-open {
        display: flex !important;

        visibility: visible !important;
        opacity: 1 !important;

        pointer-events: auto !important;
    }


    .navbar nav a {
        display: flex !important;

        align-items: center !important;
        justify-content: flex-start !important;

        width: 100% !important;

        min-height: 45px !important;

        padding: 11px 14px !important;

        box-sizing: border-box !important;

        color: #172033 !important;

        background: white !important;

        border-radius: 10px !important;

        font-size: 14px !important;

        text-decoration: none !important;
    }


    .navbar nav a:hover {
        background: #eef7f1 !important;
        color: #16834a !important;
    }


    .navbar nav .user-name {
        display: flex !important;

        width: 100% !important;

        box-sizing: border-box !important;

        padding: 11px 14px !important;

        background: #f5f8f6 !important;

        border-radius: 10px !important;
    }


    .navbar nav .nav-spacer {
        display: block !important;

        width: 100% !important;
        height: 1px !important;

        margin: 3px 0 !important;

        background: #e5ebe7 !important;
    }
}

/* =========================================
   MOBILE RIGHT SIDE MENU - FINAL
   ========================================= */

@media (max-width: 600px) {

    /* Mobile navbar */
    .navbar {
        position: relative;
        z-index: 1000;
        height: 72px;
        padding: 0 18px;
    }

    /* Keep logo and Report Waste visible */
    .navbar .logo {
        font-size: 24px;
        white-space: nowrap;
    }

    /* Mobile navigation drawer */
    .navbar nav {
        position: fixed;
        top: 82px;
        right: 15px;
        left: auto;

        width: 52%;
        max-width: 260px;
        min-width: 210px;

        height: auto;
        max-height: calc(100vh - 105px);

        padding: 18px 14px;

        display: flex;
        flex-direction: column;
        align-items: stretch;
        gap: 4px;

        background: rgba(255, 255, 255, 0.98);

        border: 1px solid #e3eee7;
        border-radius: 22px;

        box-shadow:
            0 18px 45px rgba(20, 70, 40, 0.18),
            0 4px 15px rgba(0, 0, 0, 0.08);

        overflow-y: auto;

        transform: translateX(120%);
        opacity: 0;
        visibility: hidden;

        transition:
            transform 0.35s ease,
            opacity 0.25s ease,
            visibility 0.35s ease;

        z-index: 2000;
    }

    /* When menu is opened */
    .navbar nav.mobile-menu-open,
    .navbar nav.show,
    .navbar nav.active {
        transform: translateX(0);
        opacity: 1;
        visibility: visible;
    }

    /* Menu links */
    .navbar nav a {
        width: 100%;
        box-sizing: border-box;

        display: flex;
        align-items: center;

        padding: 14px 12px;

        border-radius: 12px;

        font-size: 15px;
        font-weight: 600;

        color: #172033;

        transition:
            background 0.2s ease,
            color 0.2s ease,
            transform 0.2s ease;
    }

    .navbar nav a:hover {
        background: #eaf7ef;
        color: #16834a;
        transform: translateX(3px);
    }

    /* Remove unnecessary spacer on mobile */
    .navbar nav .nav-spacer {
        display: none;
    }

    /* User name */
    .navbar nav .user-name {
        padding: 13px 12px;
        margin-top: 5px;

        border-top: 1px solid #e5ebe7;

        font-size: 14px;
        color: #16834a;
    }

}

/* =========================
   STATUS TRACKER
   ========================= */

.status-tracker {
    display: flex;
    align-items: flex-start;
    justify-content: space-between;
    position: relative;
    margin: 25px 5px 10px;
    padding: 0 5px;
}

.status-tracker::before {
    content: "";
    position: absolute;
    top: 18px;
    left: 12%;
    right: 12%;
    height: 4px;
    background: #dfe7e2;
    border-radius: 10px;
    z-index: 0;
}

.status-step {
    position: relative;
    z-index: 1;
    width: 33.33%;
    text-align: center;
}

.status-circle {
    width: 36px;
    height: 36px;
    margin: 0 auto 8px;
    border-radius: 50%;
    background: #e2e8e4;
    color: #667085;
    display: flex;
    align-items: center;
    justify-content: center;
    font-weight: bold;
    border: 4px solid white;
    box-shadow: 0 2px 8px rgba(0,0,0,0.08);
}

.status-step.completed .status-circle,
.status-step.active .status-circle {
    background: #16834a;
    color: white;
}

.status-step.completed .status-label,
.status-step.active .status-label {
    color: #16834a;
    font-weight: 700;
}

.status-label {
    font-size: 12px;
    color: #667085;
}

.status-step.active .status-label {
    font-size: 13px;
}

@media (max-width: 600px) {

    .status-tracker {
        margin: 22px 0 8px;
    }

    .status-tracker::before {
        top: 17px;
        left: 15%;
        right: 15%;
    }

    .status-circle {
        width: 32px;
        height: 32px;
        font-size: 13px;
    }

    .status-label {
        font-size: 10px;
    }

    .status-step.active .status-label {
        font-size: 11px;
    }
}


/* =========================
   PROFILE PAGE
   ========================= */

.profile-page {
    min-height: 80vh;
    padding: 55px 20px;
    background: #f4f8f5;
}

.profile-container {
    width: 90%;
    max-width: 650px;
    margin: auto;
}

.profile-header {
    text-align: center;
    margin-bottom: 30px;
}

.profile-icon {
    width: 70px;
    height: 70px;
    margin: auto;
    display: flex;
    align-items: center;
    justify-content: center;
    background: #e8f5e9;
    border-radius: 50%;
    font-size: 34px;
    box-shadow: 0 5px 15px rgba(0,0,0,0.08);
}

.profile-header h1 {
    margin: 15px 0 8px;
    color: #172033;
    font-size: 38px;
}

.profile-header p {
    color: #667085;
}

.profile-card {
    background: white;
    padding: 32px;
    border-radius: 20px;
    box-shadow: 0 8px 25px rgba(0,0,0,0.08);
}

.account-badge {
    display: inline-block;
    margin-bottom: 25px;
    padding: 8px 14px;
    border-radius: 20px;
    background: #e8f5e9;
    color: #16834a;
    font-size: 13px;
    font-weight: 700;
}

.profile-field {
    margin-bottom: 20px;
}

.profile-field label {
    display: block;
    margin-bottom: 8px;
    color: #172033;
    font-weight: 700;
}

.profile-field input {
    width: 100%;
    box-sizing: border-box;
    padding: 13px 14px;
    border: 1px solid #d8e0da;
    border-radius: 10px;
    font-size: 15px;
    outline: none;
    transition: 0.2s;
}

.profile-field input:focus {
    border-color: #16834a;
    box-shadow: 0 0 0 3px rgba(22,131,74,0.10);
}

.profile-field small {
    display: block;
    margin-top: 7px;
    color: #777;
    font-size: 12px;
}

.profile-save-btn {
    width: 100%;
    margin-top: 5px;
    padding: 14px;
    border: none;
    border-radius: 10px;
    background: #16834a;
    color: white;
    font-size: 15px;
    font-weight: 700;
    cursor: pointer;
    transition: 0.2s;
}

.profile-save-btn:hover {
    background: #116b3c;
    transform: translateY(-1px);
}

@media (max-width: 600px) {

    .profile-page {
        padding: 35px 15px;
    }

    .profile-container {
        width: 100%;
    }

    .profile-header h1 {
        font-size: 30px;
    }

    .profile-card {
        padding: 22px;
        border-radius: 16px;
    }

}


/* =========================
   NAVBAR PROFILE BUTTON
   ========================= */

.user-profile-link {
    display: inline-flex;
    align-items: center;
    gap: 7px;
    padding: 9px 14px;
    border-radius: 12px;
    background: #f1f8f3;
    color: #16834a !important;
    font-weight: 700 !important;
    text-decoration: none;
    border: 1px solid #dcefe2;
    transition: all 0.25s ease;
}

.user-profile-link:hover {
    background: #16834a;
    color: white !important;
    transform: translateY(-1px);
    box-shadow: 0 5px 15px rgba(22, 131, 74, 0.18);
}


/* =========================
   PASSWORD FIELD
   ========================= */

.password-field {
    position: relative;
    width: 100%;
}

.password-field input {
    width: 100%;
    box-sizing: border-box;
    padding-right: 52px;
}

.password-toggle {
    position: absolute;
    right: 10px;
    top: 50%;
    transform: translateY(-50%);
    width: 38px;
    height: 38px;
    border: none;
    background: transparent;
    cursor: pointer;
    font-size: 18px;
    border-radius: 8px;
    transition: background 0.2s ease;
}

.password-toggle:hover {
    background: #f1f5f2;
}

@media (max-width: 600px) {

    .user-profile-link {
        width: 100%;
        box-sizing: border-box;
        justify-content: flex-start;
        padding: 12px 15px;
    }

    .password-toggle {
        right: 7px;
    }

}


/* Profile action indicator */
.user-profile-link::after {
    content: "✎";
    font-size: 13px;
    opacity: 0.65;
    margin-left: 2px;
    transition: transform 0.2s ease, opacity 0.2s ease;
}

.user-profile-link:hover::after {
    opacity: 1;
    transform: rotate(-10deg);
}



/* =========================
   COMPACT PASSWORD TOGGLE
   ========================= */

.password-field {
    position: relative;
    width: 100%;
}

.password-field input {
    width: 100%;
    box-sizing: border-box;
    padding-right: 45px;
}

.password-toggle {
    position: absolute !important;
    right: 10px !important;
    top: 50% !important;
    transform: translateY(-50%) !important;

    width: 32px !important;
    height: 32px !important;
    min-width: 32px !important;

    padding: 0 !important;
    margin: 0 !important;

    border: none !important;
    outline: none !important;
    background: transparent !important;
    box-shadow: none !important;

    display: flex !important;
    align-items: center !important;
    justify-content: center !important;

    font-size: 18px !important;
    cursor: pointer !important;
}

.password-toggle:hover,
.password-toggle:focus,
.password-toggle:active {
    background: transparent !important;
    box-shadow: none !important;
    border: none !important;
    outline: none !important;
}

/* =========================
   MOBILE FORM / KEYBOARD FIX
   Keep navbar visible when inputs are focused
   ========================= */

@media (max-width: 700px) {

    .navbar {
        position: sticky;
        top: 0;
        z-index: 10000;
    }

    .auth-container {
        scroll-margin-top: 80px;
    }

    .auth-container input,
    .auth-container textarea,
    .auth-container select {
        scroll-margin-top: 90px;
    }

    .auth-container input:focus,
    .auth-container textarea:focus,
    .auth-container select:focus {
        scroll-margin-top: 90px;
    }

}


/* ================================
   FINAL MOBILE NAVBAR VISIBILITY FIX
   ================================ */

@media (max-width: 700px) {

    .navbar {
        position: sticky !important;
        top: 0 !important;
        z-index: 99999 !important;
        min-height: 58px !important;
        overflow: visible !important;
    }

    .navbar nav#mainNav {
        display: flex !important;
        visibility: visible !important;
        opacity: 1 !important;
    }

    .navbar .menu-toggle {
        display: flex !important;
        visibility: visible !important;
        opacity: 1 !important;
        position: relative !important;
        z-index: 100000 !important;
    }

}

/* Keep navbar visible while typing in login/register forms */

@media (max-width: 700px) {

    .auth-container:focus-within {
        scroll-margin-top: 70px;
    }

    .auth-container input:focus {
        scroll-margin-top: 80px;
    }

}


/* ================================
   MOBILE NAVIGATION FINAL FIX
   ================================ */

@media (max-width: 700px) {

    .navbar {
        position: sticky !important;
        top: 0 !important;
        z-index: 99999 !important;
        overflow: visible !important;
    }

    .navbar .menu-toggle {
        display: flex !important;
        visibility: visible !important;
        opacity: 1 !important;
        z-index: 100000 !important;
    }

    .navbar nav#mainNav {
        visibility: visible !important;
        opacity: 1 !important;
        z-index: 99999 !important;
    }

    .navbar nav#mainNav.mobile-open {
        display: flex !important;
    }

}


/* ==========================================
   FINAL MOBILE NAVIGATION
   ========================================== */

@media (max-width: 700px) {

    .navbar {
        position: sticky !important;
        top: 0 !important;
        z-index: 99999 !important;
        overflow: visible !important;
    }

    .navbar .menu-toggle {
        display: flex !important;
        visibility: visible !important;
        opacity: 1 !important;
        position: relative !important;
        z-index: 100000 !important;
    }

    /* CLOSED */
    .navbar nav#mainNav {
        display: none !important;
        visibility: visible !important;
        opacity: 1 !important;
        pointer-events: none !important;
    }

    /* OPEN */
    .navbar nav#mainNav.mobile-open {
        display: flex !important;
        visibility: visible !important;
        opacity: 1 !important;
        pointer-events: auto !important;
    }

}

